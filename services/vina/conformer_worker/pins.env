# Pins for the isolated GPU conformer worker environment.
#
# Single source of truth for services/vina/Dockerfile (gpu-final) and both
# training images. build_env.sh reads this file; images record its hash in
# /opt/aevom-conformer-worker/share/aevom-conformer-worker/build-info.json and
# in the aevom.conformer_worker.pins_sha label. Changing anything here or in
# build_env.sh requires rebuilding those images.

WORKER_PREFIX=/opt/aevom-conformer-worker
BUILD_PREFIX=/opt/aevom-conformer-worker-build

# nvMolKit v0.6.0. refs/tags/v0.6.0 is a lightweight tag on this commit and
# pyproject.toml at this commit declares version 0.6.0; build_env.sh checks both.
NVMOLKIT_REPO=https://github.com/NVIDIA-Digital-Bio/nvMolKit.git
NVMOLKIT_REF=ccbb5a4bbc2e8874c09e3fc9dd031162d8db9c91
NVMOLKIT_VERSION=0.6.0
# "full" builds sm_70 (Volta) through sm_90 with CUDA 12.6.
NVMOLKIT_CUDA_TARGET_MODE=full

# The worker's own interpreter. Independent of each image's parent Python.
WORKER_PYTHON_VERSION=3.11
# Inside nvMolKit v0.6.0's supported range (2025.09.1 - 2026.03.5).
RDKIT_VERSION=2025.09.5
# CUDA toolkit/runtime from conda-forge, not the base image. Needs driver >= 560.
CUDA_VERSION=12.6
# nvcc 12.6 supports host GCC up to 13.
GCC_VERSION=13
# nvMolKit's Python layer imports torch (nvmolkit/types.py); CPU build only.
TORCH_VERSION=2.10.0+cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

MICROMAMBA_VERSION=2.3.2-0
MICROMAMBA_SHA256=ffc3cb8d52d4d6b354bdbb979c407719c485392b74e462cbd50811aa88e58f85

# aarch64 (Grace: DGX Spark, GH200). build_env.sh uses these in place of the
# values above. CUDA 12.6 cannot compile for Blackwell; 12.9 is the oldest nvcc
# that targets GB10 (sm_121) natively and still needs only a 575+ driver.
CUDA_VERSION_AARCH64=12.9
MICROMAMBA_SHA256_AARCH64=7154d66112a623d8d930f8aab467347971d5c1403a84b1c25d19298f4fb9da03
