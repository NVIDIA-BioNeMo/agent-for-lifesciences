# "<python> -I <worker.py>"; run the real worker with the stub nvMolKit.
[ "$1" = "-I" ] || { echo "stub-python: expected -I, got $1" >&2; exit 64; }
exec "${STUB_REAL_PYTHON:?}" -I "$(dirname "$0")/launch_worker.py" "$2"
