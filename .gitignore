# Claude Code local state: settings.local.json is per-machine by convention, and
# worktrees/ is agent scratch space holding a second checkout of this repo.
#
# Listed individually rather than ignoring .claude/ wholesale. Shared agent
# config lives in .cursor/ and is tracked; a .claude/skills/ or .claude/commands/
# added later should still be committable rather than silently untracked.
.claude/settings.local.json
.claude/worktrees/

# OS files
.DS_Store
Thumbs.db

# Docker
*.log

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Jupyter
.ipynb_checkpoints/

# Generated version file (from git describe)
.version

# Build stamps for incremental Make builds
.build-stamps/

# Development files
tmp/

# Harbor eval job output: trajectories, per-trial verdicts, gate.json, and the
# scratch copy of the tool cache. Regenerated on every run. The fixtures under
# evals/fixtures/ are committed on purpose and are not covered by this.
#
# Anchored to the repo root on purpose: an unanchored `jobs/` also matches the
# `backend/api/jobs/` source package, so a new module added there would be
# silently untracked. The existing files in it are only tracked because they
# predate the rule.
/jobs/

# Local downloads from examples/storage-access/README.md.
/aevom-results/

aevom-with-gym.code-workspace

# Large training data (use cluster storage, not git)
training/data/aevom_train.jsonl
